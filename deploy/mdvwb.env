# MDVWB per-bus configuration template.
# Installed instances use /etc/default/mdvwb-<bus>.
MDVWB_ADDRESSES="1"
MDVWB_PORT="/dev/ttyRS485-1"
MDVWB_BUS="1"
MDVWB_PROTOCOL="mdv"
MDVWB_MASTER_ID="0"

# Populated by mdvwb-manager for protocol=modbus_rtu. They stay empty for MDV.
MDVWB_MODBUS_PROFILE=""
MDVWB_MODBUS_PROFILE_DIR=""
MDVWB_MODBUS_BAUD_RATE=""
MDVWB_MODBUS_DATA_BITS=""
MDVWB_MODBUS_PARITY=""
MDVWB_MODBUS_STOP_BITS=""
MDVWB_MODBUS_RESPONSE_TIMEOUT_MS="200"

# MDV keeps its existing common transaction period and response timeout.
# Modbus uses separate start-to-start periods for ordinary polling, successful
# command/confirmation work, and failures/retries.
MDVWB_PERIOD_MS="150"
MDVWB_RESPONSE_TIMEOUT_MS="130"
MDVWB_MODBUS_COMMAND_PERIOD_MS="20"
MDVWB_MODBUS_RETRY_PERIOD_MS="500"
MDVWB_MODBUS_WRITE_ATTEMPTS="3"
MDVWB_MODBUS_CONFIRMATION_ATTEMPTS="3"
MDVWB_MODBUS_PRIORITY_BURST="4"

MDVWB_MQTT_HOST="127.0.0.1"
MDVWB_MQTT_PORT="1883"
MDVWB_MQTT_USER=""
MDVWB_MQTT_PASSWORD=""
MDVWB_MQTT_KEEPALIVE="60"
MDVWB_MQTT_RECONNECT="1"
MDVWB_MQTT_RECONNECT_MAX="10"

# 1 publishes GanGetID every transaction; keep 0 during normal operation.
MDVWB_PUBLISH_POLL_ADDRESS="0"

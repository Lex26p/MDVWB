# MQTT connection shared with MDVWB manager and bus drivers.
MDVWB_MQTT_HOST="127.0.0.1"
MDVWB_MQTT_PORT="1883"
MDVWB_MQTT_USER=""
MDVWB_MQTT_PASSWORD=""
MDVWB_MQTT_KEEPALIVE="60"
MDVWB_MQTT_RECONNECT="1"
MDVWB_MQTT_RECONNECT_MAX="10"

# Configurations validated before every execution.
MDVWB_BUSES_CONFIG="/etc/mdvwb/buses.json"
MDVWB_DASHBOARD_CONFIG="/etc/mdvwb/dashboard.json"
MDVWB_SCHEDULES_CONFIG="/etc/mdvwb/schedules.json"

# Prevents an automatic schedule from executing twice after a service restart
# in the same local minute.
MDVWB_SCHEDULER_STATE="/var/lib/mdvwb/scheduler-state.tsv"

# Wait for factual base MQTT topics after publishing /on1 commands.
MDVWB_SCHEDULER_CONFIRM_TIMEOUT="10"

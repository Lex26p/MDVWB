canonical_directory()
{
    directory=$1
    [ -d "$directory" ] || fail 2 "package directory does not exist: $directory"
    (CDPATH= cd -- "$directory" && pwd)
}

validate_package_layout()
{
    package=$1
    while IFS= read -r required; do
        [ -n "$required" ] || continue
        require_file "$package/$required"
    done <<EOF
$(required_package_files)
EOF

    require_executable "$package/MDVWB"
    require_executable "$package/mdvwb-offline"
    require_executable "$package/mdvwb-manager"
    require_executable "$package/mdvwb-scheduler"
    require_executable "$package/mdvwb-run"
    require_executable "$package/mdvwb-setup"
}

verify_package_checksums()
{
    package=$1
    require_command sha256sum
    (
        cd "$package"
        sha256sum -c SHA256SUMS
    )
}

verify_controller()
{
    require_command "$MDVWB_DPKG"
    require_command "$MDVWB_LDCONFIG"
    require_command "$MDVWB_SYSTEMCTL"

    actual_architecture=$("$MDVWB_DPKG" --print-architecture 2>/dev/null || true)
    [ "$actual_architecture" = "$MANIFEST_ARCHITECTURE" ] ||
        fail 2 "unsupported controller architecture: $actual_architecture; expected $MANIFEST_ARCHITECTURE"

    "$MDVWB_LDCONFIG" -p 2>/dev/null | grep -q 'libmosquitto\.so\.1' ||
        fail 2 "libmosquitto.so.1 is not installed on this controller"
}

run_package_self_tests()
{
    package=$1
    "$package/MDVWB" --version
    "$package/MDVWB" --self-test
    "$package/mdvwb-offline" --self-test
    "$package/mdvwb-scheduler" --help >/dev/null
}

configured_bus_ids()
{
    manager=$1
    config=$2
    [ -s "$config" ] || return 0
    "$manager" summary "$config" |
        sed -n 's/^bus=\([0-9][0-9]*\) .*/\1/p'
}

enabled_bus_ids()
{
    manager=$1
    config=$2
    [ -s "$config" ] || return 0
    "$manager" summary "$config" |
        sed -n 's/^bus=\([0-9][0-9]*\) enabled=true .*/\1/p'
}

validate_existing_configuration()
{
    package=$1
    config=$(root_path /etc/mdvwb/buses.json)
    if [ -s "$config" ]; then
        "$package/mdvwb-manager" validate "$config"
    fi

    dashboard=$(root_path /etc/mdvwb/dashboard.json)
    schedules=$(root_path /etc/mdvwb/schedules.json)
    [ ! -e "$dashboard" ] || [ -r "$dashboard" ] ||
        fail 2 "existing dashboard configuration is not readable: $dashboard"
    [ ! -e "$schedules" ] || [ -r "$schedules" ] ||
        fail 2 "existing schedules configuration is not readable: $schedules"
}

print_install_plan()
{
    package=$1
    method=$2
    state=$3

    printf '%s\n' \
        "ACTION=$ACTION current=$CURRENT_VERSION target=$MANIFEST_VERSION architecture=$MANIFEST_ARCHITECTURE" \
        "package=$package" \
        "method=$method" \
        "root=$MDVWB_ROOT" \
        "state=$state" \
        "preserve=/etc/mdvwb/buses.json" \
        "preserve=/etc/mdvwb/dashboard.json" \
        "preserve=/etc/mdvwb/schedules.json" \
        "preserve=/var/www/fancoils/assets"
}

stop_existing_services()
{
    package=$1
    config=$(root_path /etc/mdvwb/buses.json)

    "$MDVWB_SYSTEMCTL" stop mdvwb-scheduler.service 2>/dev/null || true
    "$MDVWB_SYSTEMCTL" stop mdvwb-manager.service 2>/dev/null || true
    for bus in $(configured_bus_ids "$package/mdvwb-manager" "$config"); do
        "$MDVWB_SYSTEMCTL" stop "mdvwb@$bus.service" 2>/dev/null || true
    done
}

install_runtime_files()
{
    package=$1
    www_root=$2

    bin_dir=$(root_path /usr/local/bin)
    sbin_dir=$(root_path /usr/local/sbin)
    lib_dir=$(root_path /usr/local/lib/mdvwb)
    config_dir=$(root_path /etc/mdvwb)
    default_dir=$(root_path /etc/default)
    systemd_dir=$(root_path /etc/systemd/system)
    state_dir=$(root_path /var/lib/mdvwb)

    install -d -m 0755 \
        "$bin_dir" "$sbin_dir" "$lib_dir" "$config_dir" "$default_dir" \
        "$systemd_dir" "$state_dir" \
        "$www_root/mdvwb" "$www_root/fancoils" "$www_root/fancoils/assets"

    install -m 0755 "$package/MDVWB" "$bin_dir/MDVWB"
    install -m 0755 "$package/mdvwb-offline" "$bin_dir/mdvwb-offline"
    install -m 0755 "$package/mdvwb-manager" "$bin_dir/mdvwb-manager"
    install -m 0755 "$package/mdvwb-scheduler" "$bin_dir/mdvwb-scheduler"
    install -m 0755 "$package/mdvwb-setup" "$sbin_dir/mdvwb-setup"
    install -m 0755 "$package/mdvwb-run" "$lib_dir/mdvwb-run"
    install -m 0640 "$package/mdvwb.env" "$lib_dir/mdvwb.env"
    install -m 0644 "$package/mdvwb@.service" "$systemd_dir/mdvwb@.service"
    install -m 0644 "$package/mdvwb-manager.service" \
        "$systemd_dir/mdvwb-manager.service"
    install -m 0644 "$package/mdvwb-scheduler.service" \
        "$systemd_dir/mdvwb-scheduler.service"

    if [ ! -e "$default_dir/mdvwb-manager" ]; then
        install -m 0640 "$package/mdvwb-manager.env" "$default_dir/mdvwb-manager"
    fi
    if [ ! -e "$default_dir/mdvwb-scheduler" ]; then
        install -m 0640 "$package/mdvwb-scheduler.env" "$default_dir/mdvwb-scheduler"
    fi

    cp -R "$package/www/mdvwb/." "$www_root/mdvwb/"
    cp -R "$package/www/fancoils/." "$www_root/fancoils/"
    find "$www_root/mdvwb" "$www_root/fancoils" -type d -exec chmod 0755 {} +
    find "$www_root/mdvwb" "$www_root/fancoils" -type f -exec chmod 0644 {} +
}

ensure_initial_configuration()
{
    package=$1
    bin_dir=$(root_path /usr/local/bin)
    config_dir=$(root_path /etc/mdvwb)
    buses="$config_dir/buses.json"

    if [ ! -s "$buses" ]; then
        if "$bin_dir/mdvwb-manager" migrate-defaults "$buses"; then
            printf '%s\n' "Migrated legacy MDVWB bus configuration."
        else
            migration_status=$?
            if [ "$migration_status" -eq 3 ]; then
                install -m 0640 "$package/buses.default.json" "$buses"
                printf '%s\n' \
                    "No legacy configuration was found; installed an empty buses.json."
            else
                fail "$migration_status" \
                    "legacy MDVWB configuration exists but could not be migrated"
            fi
        fi
    fi

    if [ ! -s "$config_dir/dashboard.json" ]; then
        install -m 0640 "$package/dashboard.default.json" \
            "$config_dir/dashboard.json"
    fi
    if [ ! -s "$config_dir/schedules.json" ]; then
        install -m 0640 "$package/schedules.default.json" \
            "$config_dir/schedules.json"
    fi

    "$bin_dir/mdvwb-manager" validate "$buses"
}

clean_legacy_runtime()
{
    systemd_dir=$(root_path /etc/systemd/system)
    bin_dir=$(root_path /usr/local/bin)
    rules_dir=$(root_path /etc/wb-rules)

    "$MDVWB_SYSTEMCTL" disable --now mdvwb.service mdvwb-2.service \
        2>/dev/null || true
    rm -f "$systemd_dir/mdvwb.service" "$systemd_dir/mdvwb-2.service"
    rm -f "$bin_dir/mdvwb-bus"

    if [ -d "$rules_dir" ]; then
        for rule in "$rules_dir"/*.js; do
            [ -f "$rule" ] || continue
            if grep -Eq 'var[[:space:]]+ArrID[[:space:]]*=' "$rule" &&
               grep -q 'defineVirtualDevice("Fan-"' "$rule"; then
                mv "$rule" "$rule.disabled-mdvwb"
                printf 'Disabled legacy fan virtual-device rule: %s\n' "$rule"
            fi
        done
        rm -f "$rules_dir/mdvwb-service-control.js"
        "$MDVWB_SYSTEMCTL" restart wb-rules.service 2>/dev/null || true
    fi
}

clean_retained_topics()
{
    manager=$1
    config=$2

    command -v mqtt-delete-retained >/dev/null 2>&1 || return 0
    for bus in $(configured_bus_ids "$manager" "$config"); do
        address=0
        while [ "$address" -le 63 ]; do
            mqtt-delete-retained \
                "/devices/Fan-${bus}_${address}/#" >/dev/null 2>&1 || true
            address=$((address + 1))
        done
        mqtt-delete-retained "/devices/sist-${bus}/#" >/dev/null 2>&1 || true
    done
}

start_and_verify_services()
{
    bin_dir=$(root_path /usr/local/bin)
    config=$(root_path /etc/mdvwb/buses.json)

    "$MDVWB_SYSTEMCTL" daemon-reload
    "$bin_dir/MDVWB" --version
    "$bin_dir/MDVWB" --self-test
    "$bin_dir/mdvwb-offline" --self-test
    "$bin_dir/mdvwb-manager" validate "$config"
    "$bin_dir/mdvwb-manager" apply "$config"
    "$MDVWB_SYSTEMCTL" enable --now mdvwb-manager.service
    "$MDVWB_SYSTEMCTL" enable --now mdvwb-scheduler.service

    if [ "$MDVWB_SERVICE_START_DELAY" -gt 0 ]; then
        sleep "$MDVWB_SERVICE_START_DELAY"
    fi

    "$MDVWB_SYSTEMCTL" is-active --quiet mdvwb-manager.service ||
        fail 7 "mdvwb-manager.service failed to start"
    "$MDVWB_SYSTEMCTL" is-active --quiet mdvwb-scheduler.service ||
        fail 7 "mdvwb-scheduler.service failed to start"

    for bus in $(enabled_bus_ids "$bin_dir/mdvwb-manager" "$config"); do
        "$MDVWB_SYSTEMCTL" is-active --quiet "mdvwb@$bus.service" ||
            fail 7 "mdvwb@$bus.service failed to start"
    done
}

perform_install()
{
    package=$1
    method=$2
    state=$3

    if [ -n "${MDVWB_WWW_ROOT:-}" ]; then
        www_root=$MDVWB_WWW_ROOT
    else
        www_root=$(root_path /var/www)
    fi
    case "$www_root" in
        /*)
            ;;
        *)
            fail 2 "MDVWB_WWW_ROOT must be an absolute path"
            ;;
    esac

    printf '[1/8] Stop MDVWB services\n'
    stop_existing_services "$package"

    printf '[2/8] Install binaries, units and web applications\n'
    install_runtime_files "$package" "$www_root"

    printf '[3/8] Prepare configuration\n'
    ensure_initial_configuration "$package"

    printf '[4/8] Clean legacy runtime files\n'
    clean_legacy_runtime

    printf '[5/8] Clean retained device topics\n'
    clean_retained_topics \
        "$(root_path /usr/local/bin/mdvwb-manager)" \
        "$(root_path /etc/mdvwb/buses.json)"

    printf '[6/8] Apply configuration and start services\n'
    start_and_verify_services

    printf '[7/8] Write installation state\n'
    write_installation_state "$package/manifest.json" "$method" "$state"

    printf '[8/8] Installation complete\n'
    printf '%s\n' \
        "MDVWB_RESULT=success" \
        "action=$ACTION" \
        "version=$MANIFEST_VERSION" \
        "method=$method" \
        "state=$state" \
        "engineeringWeb=http://<WB-address>/mdvwb/" \
        "operatorWeb=http://<WB-address>/fancoils/"
}


command_apply_internal()
{
    [ "$#" -eq 4 ] ||
        fail 2 "internal apply requires package, method, state and action"

    package=$1
    method=$2
    state=$3
    ACTION=$4
    load_manifest "$package/manifest.json"
    perform_install "$package" "$method" "$state"
}


command_manifest()
{
    manifest=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --manifest)
                [ "$#" -ge 2 ] || fail 2 "--manifest requires a path"
                manifest=$2
                shift 2
                ;;
            *)
                fail 2 "unknown manifest argument: $1"
                ;;
        esac
    done
    [ -n "$manifest" ] || fail 2 "--manifest is required"
    load_manifest "$manifest"

    printf '%s\n' \
        "PACKAGE_OK product=$MANIFEST_PRODUCT version=$MANIFEST_VERSION" \
        "commit=$MANIFEST_COMMIT" \
        "architecture=$MANIFEST_ARCHITECTURE" \
        "buildOs=$MANIFEST_BUILD_OS" \
        "builtAt=$MANIFEST_BUILT_AT"
}

command_verify()
{
    package=
    package_only=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --package)
                [ "$#" -ge 2 ] || fail 2 "--package requires a directory"
                package=$2
                shift 2
                ;;
            --package-only)
                package_only=1
                shift
                ;;
            *)
                fail 2 "unknown verify argument: $1"
                ;;
        esac
    done

    [ -n "$package" ] || fail 2 "--package is required"
    require_command sha256sum
    require_command grep
    require_command sed
    require_command awk

    package=$(canonical_directory "$package")
    printf '[verify 1/5] Check package layout\n'
    validate_package_layout "$package"
    require_executable "$package/offline-install.sh"

    printf '[verify 2/5] Validate package manifest\n'
    load_manifest "$package/manifest.json"

    printf '[verify 3/5] Verify package checksums\n'
    verify_package_checksums "$package"

    printf '[verify 4/5] Run package self-tests\n'
    run_package_self_tests "$package"

    if [ "$package_only" -eq 0 ]; then
        printf '[verify 5/5] Verify controller and existing configuration\n'
        verify_controller
        validate_existing_configuration "$package"
        verification_scope=controller
    else
        printf '[verify 5/5] Controller checks skipped\n'
        verification_scope=package
    fi

    printf '%s\n' \
        "VERIFY_RESULT=success" \
        "scope=$verification_scope" \
        "product=$MANIFEST_PRODUCT" \
        "version=$MANIFEST_VERSION" \
        "commit=$MANIFEST_COMMIT" \
        "architecture=$MANIFEST_ARCHITECTURE" \
        "package=$package"
}


command_status()
{
    state=$DEFAULT_STATE_PATH
    health=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --state)
                [ "$#" -ge 2 ] || fail 2 "--state requires a path"
                state=$2
                shift 2
                ;;
            --health)
                health=1
                shift
                ;;
            *)
                fail 2 "unknown status argument: $1"
                ;;
        esac
    done

    if [ ! -s "$state" ]; then
        printf 'NOT_INSTALLED state=%s\n' "$state"
        return 3
    fi

    load_state "$state"
    printf '%s\n' \
        "INSTALLED product=$STATE_PRODUCT version=$STATE_VERSION" \
        "commit=$STATE_COMMIT" \
        "architecture=$STATE_ARCHITECTURE" \
        "installedAt=$STATE_INSTALLED_AT" \
        "installMethod=$STATE_METHOD" \
        "state=$state"

    [ "$health" -eq 1 ] || return 0

    require_command "$MDVWB_SYSTEMCTL"
    manager=$(root_path /usr/local/bin/mdvwb-manager)
    config=$(root_path /etc/mdvwb/buses.json)
    health_ok=1
    config_valid=0

    if [ ! -x "$manager" ]; then
        printf 'component=mdvwb-manager state=missing\n'
        health_ok=0
    elif [ ! -s "$config" ]; then
        printf 'configuration=buses.json state=missing\n'
        health_ok=0
    elif "$manager" validate "$config" >/dev/null 2>&1; then
        printf 'configuration=buses.json state=valid\n'
        config_valid=1
    else
        printf 'configuration=buses.json state=invalid\n'
        health_ok=0
    fi

    for service in mdvwb-manager.service mdvwb-scheduler.service; do
        active=false
        enabled=false
        if "$MDVWB_SYSTEMCTL" is-active --quiet "$service" >/dev/null 2>&1; then
            active=true
        fi
        if "$MDVWB_SYSTEMCTL" is-enabled --quiet "$service" >/dev/null 2>&1; then
            enabled=true
        fi
        printf 'service=%s active=%s enabled=%s required=true\n' \
            "$service" "$active" "$enabled"
        if [ "$active" != true ] || [ "$enabled" != true ]; then
            health_ok=0
        fi
    done

    if [ "$config_valid" -eq 1 ]; then
        for bus in $(enabled_bus_ids "$manager" "$config"); do
            service="mdvwb@$bus.service"
            active=false
            enabled=false
            if "$MDVWB_SYSTEMCTL" is-active --quiet "$service" >/dev/null 2>&1; then
                active=true
            fi
            if "$MDVWB_SYSTEMCTL" is-enabled --quiet "$service" >/dev/null 2>&1; then
                enabled=true
            fi
            printf 'service=%s active=%s enabled=%s required=true\n' \
                "$service" "$active" "$enabled"
            if [ "$active" != true ] || [ "$enabled" != true ]; then
                health_ok=0
            fi
        done
    fi

    if [ "$health_ok" -eq 1 ]; then
        printf '%s\n' "HEALTH=OK"
        return 0
    fi

    printf '%s\n' "HEALTH=FAILED"
    return 7
}

command_check_version()
{
    manifest=
    state=$DEFAULT_STATE_PATH
    force=0
    allow_downgrade=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --manifest)
                [ "$#" -ge 2 ] || fail 2 "--manifest requires a path"
                manifest=$2
                shift 2
                ;;
            --state)
                [ "$#" -ge 2 ] || fail 2 "--state requires a path"
                state=$2
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            --allow-downgrade)
                allow_downgrade=1
                shift
                ;;
            *)
                fail 2 "unknown check-version argument: $1"
                ;;
        esac
    done

    [ -n "$manifest" ] || fail 2 "--manifest is required"
    determine_action "$manifest" "$state" "$force" "$allow_downgrade" 0
    printf 'ACTION=%s current=%s target=%s architecture=%s\n' \
        "$ACTION" "$CURRENT_VERSION" "$MANIFEST_VERSION" \
        "$MANIFEST_ARCHITECTURE"
}

command_write_state()
{
    manifest=
    state=$DEFAULT_STATE_PATH
    method=

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --manifest)
                [ "$#" -ge 2 ] || fail 2 "--manifest requires a path"
                manifest=$2
                shift 2
                ;;
            --state)
                [ "$#" -ge 2 ] || fail 2 "--state requires a path"
                state=$2
                shift 2
                ;;
            --method)
                [ "$#" -ge 2 ] || fail 2 "--method requires a value"
                method=$2
                shift 2
                ;;
            *)
                fail 2 "unknown write-state argument: $1"
                ;;
        esac
    done

    [ -n "$manifest" ] || fail 2 "--manifest is required"
    case "$method" in
        offline|online|source|rollback)
            ;;
        *)
            fail 2 "--method must be offline, online, source or rollback"
            ;;
    esac

    write_installation_state "$manifest" "$method" "$state"
    load_manifest "$manifest"
    printf 'STATE_WRITTEN version=%s method=%s path=%s\n' \
        "$MANIFEST_VERSION" "$method" "$state"
}


command_backup()
{
    backup_root=$DEFAULT_BACKUP_ROOT
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --backup-dir)
                [ "$#" -ge 2 ] || fail 2 "--backup-dir requires a directory"
                backup_root=$2
                shift 2
                ;;
            *)
                fail 2 "unknown backup argument: $1"
                ;;
        esac
    done

    require_root
    require_command cp
    require_command awk
    require_command sed
    require_command grep
    require_command date
    require_command "$MDVWB_SYSTEMCTL"

    manager=$(root_path /usr/local/bin/mdvwb-manager)
    backup=$(create_backup "$backup_root" manual "$manager")
    printf '%s\n' \
        "BACKUP_CREATED path=$backup" \
        "backup=$backup"
}

command_rollback()
{
    backup=
    backup_root=$DEFAULT_BACKUP_ROOT
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --backup)
                [ "$#" -ge 2 ] || fail 2 "--backup requires a directory"
                backup=$2
                shift 2
                ;;
            --backup-dir)
                [ "$#" -ge 2 ] || fail 2 "--backup-dir requires a directory"
                backup_root=$2
                shift 2
                ;;
            *)
                fail 2 "unknown rollback argument: $1"
                ;;
        esac
    done

    require_root
    require_command cp
    require_command awk
    require_command sed
    require_command ls
    require_command "$MDVWB_SYSTEMCTL"

    if [ -z "$backup" ]; then
        backup=$(latest_backup "$backup_root")
    fi
    restore_backup "$backup"
}


command_install()
{
    require_existing=$1
    shift

    package=
    method=
    force=0
    allow_downgrade=0
    dry_run=0
    no_backup=0
    backup_root=$DEFAULT_BACKUP_ROOT

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --package)
                [ "$#" -ge 2 ] || fail 2 "--package requires a directory"
                package=$2
                shift 2
                ;;
            --method)
                [ "$#" -ge 2 ] || fail 2 "--method requires a value"
                method=$2
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            --allow-downgrade)
                allow_downgrade=1
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            --backup-dir)
                [ "$#" -ge 2 ] || fail 2 "--backup-dir requires a directory"
                backup_root=$2
                shift 2
                ;;
            --no-backup)
                no_backup=1
                shift
                ;;
            *)
                fail 2 "unknown installation argument: $1"
                ;;
        esac
    done

    [ -n "$package" ] || fail 2 "--package is required"
    case "$method" in
        offline|online|source)
            ;;
        *)
            fail 2 "--method must be offline, online or source"
            ;;
    esac

    require_root
    require_command install
    require_command cp
    require_command find
    require_command grep
    require_command sed
    require_command awk
    require_command date

    package=$(canonical_directory "$package")
    printf '[preflight 1/6] Check package layout\n'
    validate_package_layout "$package"

    printf '[preflight 2/6] Validate manifest and version transition\n'
    determine_action \
        "$package/manifest.json" "$DEFAULT_STATE_PATH" \
        "$force" "$allow_downgrade" "$require_existing"

    printf '[preflight 3/6] Verify package checksums\n'
    verify_package_checksums "$package"

    printf '[preflight 4/6] Verify controller\n'
    verify_controller

    printf '[preflight 5/6] Run package self-tests\n'
    run_package_self_tests "$package"

    printf '[preflight 6/6] Validate existing configuration\n'
    validate_existing_configuration "$package"

    print_install_plan "$package" "$method" "$DEFAULT_STATE_PATH"
    if [ "$no_backup" -eq 1 ]; then
        printf '%s\n' "backup=disabled"
    else
        printf 'backupRoot=%s\n' "$backup_root"
    fi

    if [ "$dry_run" -eq 1 ]; then
        printf '%s\n' "DRY_RUN=complete"
        return 0
    fi

    start_operation_log "$ACTION" "$method" "$CURRENT_VERSION" "$MANIFEST_VERSION"
    append_operation_log package "$package"

    backup=
    if [ "$no_backup" -eq 0 ]; then
        printf '[transaction] Create backup before system changes\n'
        if backup=$(create_backup \
            "$backup_root" "automatic-$ACTION" "$package/mdvwb-manager"); then
            printf 'BACKUP_CREATED path=%s\n' "$backup"
            append_operation_log backup "$backup"
        else
            backup_status=$?
            append_operation_log backup failed
            append_operation_log backupStatus "$backup_status"
            finish_operation_log failed-before-changes
            printf 'log=%s\n' "$OPERATION_LOG" >&2
            return "$backup_status"
        fi
    else
        printf '%s\n' \
            "WARNING: automatic backup and rollback are disabled." >&2
    fi

    if sh "$SELF_PATH" __apply \
        "$package" "$method" "$DEFAULT_STATE_PATH" "$ACTION"; then
        if [ -n "$backup" ]; then
            printf 'backup=%s\n' "$backup"
        fi
        finish_operation_log success
        printf 'log=%s\n' "$OPERATION_LOG"
        return 0
    else
        operation_status=$?
    fi

    printf '%s\n' \
        "INSTALLATION_FAILED status=$operation_status action=$ACTION" >&2
    append_operation_log installationStatus "$operation_status"

    if [ -z "$backup" ]; then
        printf '%s\n' \
            "ROLLBACK_RESULT=skipped reason=no-backup" >&2
        append_operation_log rollback skipped
        finish_operation_log failed
        printf 'log=%s\n' "$OPERATION_LOG" >&2
        return "$operation_status"
    fi

    printf 'Automatic rollback from %s\n' "$backup" >&2
    if restore_backup "$backup"; then
        printf '%s\n' \
            "AUTOMATIC_ROLLBACK=completed" \
            "backup=$backup" >&2
        append_operation_log rollback completed
        finish_operation_log failed-rolled-back
        printf 'log=%s\n' "$OPERATION_LOG" >&2
        return "$operation_status"
    fi

    printf '%s\n' \
        "AUTOMATIC_ROLLBACK=failed" \
        "backup=$backup" >&2
    append_operation_log rollback failed
    finish_operation_log failed-rollback-failed
    printf 'log=%s\n' "$OPERATION_LOG" >&2
    return 8
}

command=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command" in
    manifest)
        command_manifest "$@"
        ;;
    verify)
        command_verify "$@"
        ;;
    status)
        command_status "$@"
        ;;
    check-version)
        command_check_version "$@"
        ;;
    write-state)
        command_write_state "$@"
        ;;
    backup)
        command_backup "$@"
        ;;
    rollback)
        command_rollback "$@"
        ;;
    __apply)
        command_apply_internal "$@"
        ;;
    install)
        command_install 0 "$@"
        ;;
    update)
        command_install 1 "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage >&2
        fail 2 "unknown command: $command"
        ;;
esac

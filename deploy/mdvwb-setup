#!/bin/sh
set -eu

PROGRAM=${0##*/}
case "$0" in
    /*)
        SELF_PATH=$0
        ;;
    */*)
        SELF_PATH=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/${0##*/}
        ;;
    *)
        SELF_PATH=$(command -v "$0" 2>/dev/null || printf '%s' "$0")
        ;;
esac

case "${1:-}" in
    install|update|rollback)
        if [ "${MDVWB_SETUP_RUNNING_COPY:-0}" != "1" ]; then
            temporary_self=${TMPDIR:-/tmp}/mdvwb-setup-running.$$
            cp "$SELF_PATH" "$temporary_self"
            chmod 0700 "$temporary_self"
            MDVWB_SETUP_RUNNING_COPY=1             MDVWB_SETUP_TEMP_SELF=$temporary_self                 exec sh "$temporary_self" "$@"
        fi
        ;;
esac

if [ -n "${MDVWB_SETUP_TEMP_SELF:-}" ]; then
    trap 'rm -f "$MDVWB_SETUP_TEMP_SELF"' EXIT HUP INT TERM
fi

MDVWB_ROOT=${MDVWB_ROOT:-/}
MDVWB_SYSTEMCTL=${MDVWB_SYSTEMCTL:-systemctl}
MDVWB_DPKG=${MDVWB_DPKG:-dpkg}
MDVWB_LDCONFIG=${MDVWB_LDCONFIG:-ldconfig}
MDVWB_SERVICE_START_DELAY=${MDVWB_SERVICE_START_DELAY:-3}

case "$MDVWB_ROOT" in
    /*)
        ;;
    *)
        printf '%s: MDVWB_ROOT must be an absolute path\n' "$PROGRAM" >&2
        exit 2
        ;;
esac

if [ "$MDVWB_ROOT" = "/" ]; then
    ROOT_PREFIX=
else
    ROOT_PREFIX=${MDVWB_ROOT%/}
fi

DEFAULT_STATE_PATH=${MDVWB_INSTALL_STATE:-$ROOT_PREFIX/var/lib/mdvwb/installation.json}
DEFAULT_BACKUP_ROOT=${MDVWB_BACKUP_ROOT:-$ROOT_PREFIX/var/backups/mdvwb}
DEFAULT_LOG_ROOT=${MDVWB_LOG_ROOT:-$ROOT_PREFIX/var/log/mdvwb}

fail()
{
    code=$1
    shift
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit "$code"
}

usage()
{
    cat <<'EOF'
MDVWB installation lifecycle utility

Usage:
  mdvwb-setup manifest --manifest <manifest.json>
  mdvwb-setup verify --package <directory> [--package-only]
  mdvwb-setup status [--state <installation.json>] [--health]
  mdvwb-setup check-version --manifest <manifest.json>
      [--state <installation.json>] [--force] [--allow-downgrade]
  mdvwb-setup write-state --manifest <manifest.json>
      --method <offline|online|source|rollback>
      [--state <installation.json>]
  mdvwb-setup backup [--backup-dir <directory>]
  mdvwb-setup rollback [--backup <directory>]
      [--backup-dir <directory>]
  mdvwb-setup install --package <directory>
      --method <offline|online|source>
      [--force] [--allow-downgrade] [--dry-run]
      [--backup-dir <directory>] [--no-backup]
  mdvwb-setup update --package <directory>
      --method <offline|online|source>
      [--force] [--allow-downgrade] [--dry-run]
      [--backup-dir <directory>] [--no-backup]

Environment used by integration tests and advanced deployments:
  MDVWB_ROOT
  MDVWB_SYSTEMCTL
  MDVWB_DPKG
  MDVWB_LDCONFIG
  MDVWB_SERVICE_START_DELAY
  MDVWB_INSTALL_STATE
  MDVWB_BACKUP_ROOT
  MDVWB_LOG_ROOT
  MDVWB_WWW_ROOT

Exit codes:
  0  operation completed or is valid
  2  invalid arguments, package, manifest, configuration, backup or state
  3  installation state or requested backup does not exist
  4  the requested version is already installed
  5  downgrade is blocked
  6  package and installed architectures differ
  7  installed service or configuration health check failed
  8  automatic rollback failed
EOF
}

root_path()
{
    printf '%s%s\n' "$ROOT_PREFIX" "$1"
}

require_file()
{
    [ -f "$1" ] || fail 2 "file does not exist: $1"
    [ -r "$1" ] || fail 2 "file is not readable: $1"
}

require_executable()
{
    require_file "$1"
    [ -x "$1" ] || fail 2 "file is not executable: $1"
}

require_root()
{
    if [ "$MDVWB_ROOT" = "/" ] && [ "$(id -u)" -ne 0 ]; then
        fail 2 "installation must be run as root"
    fi
}

require_command()
{
    command -v "$1" >/dev/null 2>&1 ||
        fail 2 "required command is not available: $1"
}

json_string()
{
    file=$1
    key=$2
    values=$(sed -n \
        "s/^[[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\"[[:space:]]*,\{0,1\}[[:space:]]*$/\1/p" \
        "$file")
    count=$(printf '%s\n' "$values" | awk 'NF { count++ } END { print count + 0 }')
    [ "$count" -eq 1 ] ||
        fail 2 "JSON field '$key' must occur exactly once in $file"
    printf '%s\n' "$values"
}

json_number()
{
    file=$1
    key=$2
    values=$(sed -n \
        "s/^[[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\)[[:space:]]*,\{0,1\}[[:space:]]*$/\1/p" \
        "$file")
    count=$(printf '%s\n' "$values" | awk 'NF { count++ } END { print count + 0 }')
    [ "$count" -eq 1 ] ||
        fail 2 "JSON field '$key' must occur exactly once in $file"
    printf '%s\n' "$values"
}

validate_version()
{
    version=$1
    printf '%s\n' "$version" | awk -F. '
        NF != 3 { exit 1 }
        {
            for (field = 1; field <= 3; ++field) {
                if ($field !~ /^[0-9]+$/) {
                    exit 1
                }
                if (length($field) > 1 && substr($field, 1, 1) == "0") {
                    exit 1
                }
            }
        }
    ' || fail 2 "version must use canonical MAJOR.MINOR.PATCH form: $version"
}

validate_commit()
{
    commit=$1
    if [ "$commit" = "unknown" ]; then
        return
    fi
    [ "${#commit}" -eq 40 ] ||
        fail 2 "commit must be a 40-character lowercase SHA or unknown"
    case "$commit" in
        *[!0-9a-f]*)
            fail 2 "commit must be a 40-character lowercase SHA or unknown"
            ;;
    esac
}

validate_timestamp()
{
    timestamp=$1
    case "$timestamp" in
        unknown|????-??-??T??:??:??Z)
            ;;
        *)
            fail 2 "timestamp must use UTC YYYY-MM-DDTHH:MM:SSZ form or unknown"
            ;;
    esac
}

load_manifest()
{
    MANIFEST_PATH=$1
    require_file "$MANIFEST_PATH"

    MANIFEST_FORMAT=$(json_number "$MANIFEST_PATH" packageFormat)
    MANIFEST_PRODUCT=$(json_string "$MANIFEST_PATH" product)
    MANIFEST_VERSION=$(json_string "$MANIFEST_PATH" version)
    MANIFEST_COMMIT=$(json_string "$MANIFEST_PATH" commit)
    MANIFEST_ARCHITECTURE=$(json_string "$MANIFEST_PATH" architecture)
    MANIFEST_BUILD_OS=$(json_string "$MANIFEST_PATH" buildOs)
    MANIFEST_BUILT_AT=$(json_string "$MANIFEST_PATH" builtAt)

    [ "$MANIFEST_FORMAT" = "1" ] ||
        fail 2 "unsupported package format: $MANIFEST_FORMAT"
    [ "$MANIFEST_PRODUCT" = "MDVWB" ] ||
        fail 2 "unexpected package product: $MANIFEST_PRODUCT"
    validate_version "$MANIFEST_VERSION"
    validate_commit "$MANIFEST_COMMIT"
    [ "$MANIFEST_ARCHITECTURE" = "arm64" ] ||
        fail 2 "unsupported package architecture: $MANIFEST_ARCHITECTURE"
    [ -n "$MANIFEST_BUILD_OS" ] ||
        fail 2 "package buildOs must not be empty"
    validate_timestamp "$MANIFEST_BUILT_AT"
}

load_state()
{
    STATE_PATH=$1
    require_file "$STATE_PATH"

    STATE_FORMAT=$(json_number "$STATE_PATH" stateFormat)
    STATE_PRODUCT=$(json_string "$STATE_PATH" product)
    STATE_VERSION=$(json_string "$STATE_PATH" version)
    STATE_COMMIT=$(json_string "$STATE_PATH" commit)
    STATE_ARCHITECTURE=$(json_string "$STATE_PATH" architecture)
    STATE_INSTALLED_AT=$(json_string "$STATE_PATH" installedAt)
    STATE_METHOD=$(json_string "$STATE_PATH" installMethod)

    [ "$STATE_FORMAT" = "1" ] ||
        fail 2 "unsupported installation state format: $STATE_FORMAT"
    [ "$STATE_PRODUCT" = "MDVWB" ] ||
        fail 2 "unexpected installation state product: $STATE_PRODUCT"
    validate_version "$STATE_VERSION"
    validate_commit "$STATE_COMMIT"
    [ "$STATE_ARCHITECTURE" = "arm64" ] ||
        fail 2 "unsupported installed architecture: $STATE_ARCHITECTURE"
    validate_timestamp "$STATE_INSTALLED_AT"
    case "$STATE_METHOD" in
        offline|online|source|rollback)
            ;;
        *)
            fail 2 "unsupported install method: $STATE_METHOD"
            ;;
    esac
}

compare_versions()
{
    left=$1
    right=$2
    awk -v left="$left" -v right="$right" 'BEGIN {
        split(left, a, ".")
        split(right, b, ".")
        for (field = 1; field <= 3; ++field) {
            if ((a[field] + 0) < (b[field] + 0)) {
                print -1
                exit
            }
            if ((a[field] + 0) > (b[field] + 0)) {
                print 1
                exit
            }
        }
        print 0
    }'
}

determine_action()
{
    manifest=$1
    state=$2
    force=$3
    allow_downgrade=$4
    require_existing=$5

    load_manifest "$manifest"
    if [ ! -s "$state" ]; then
        if [ "$require_existing" -eq 1 ]; then
            fail 3 "MDVWB is not installed; use install instead of update"
        fi
        ACTION=install
        CURRENT_VERSION=none
        return
    fi

    load_state "$state"
    [ "$STATE_ARCHITECTURE" = "$MANIFEST_ARCHITECTURE" ] ||
        fail 6 "installed architecture $STATE_ARCHITECTURE differs from package architecture $MANIFEST_ARCHITECTURE"

    CURRENT_VERSION=$STATE_VERSION
    comparison=$(compare_versions "$MANIFEST_VERSION" "$STATE_VERSION")
    if [ "$comparison" -gt 0 ]; then
        ACTION=update
    elif [ "$comparison" -eq 0 ]; then
        if [ "$force" -ne 1 ]; then
            fail 4 "MDVWB $STATE_VERSION is already installed; use --force for repair"
        fi
        ACTION=repair
    else
        if [ "$allow_downgrade" -ne 1 ]; then
            fail 5 "downgrade from $STATE_VERSION to $MANIFEST_VERSION requires --allow-downgrade"
        fi
        ACTION=downgrade
    fi
}

write_installation_state()
{
    manifest=$1
    method=$2
    state=$3

    load_manifest "$manifest"
    installed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    state_directory=${state%/*}
    if [ "$state_directory" = "$state" ]; then
        state_directory=.
    fi
    mkdir -p "$state_directory"
    temporary="$state.tmp.$$"
    trap 'rm -f "$temporary"' EXIT HUP INT TERM
    umask 027
    cat >"$temporary" <<EOF
{
  "stateFormat": 1,
  "product": "MDVWB",
  "version": "$MANIFEST_VERSION",
  "commit": "$MANIFEST_COMMIT",
  "architecture": "$MANIFEST_ARCHITECTURE",
  "installedAt": "$installed_at",
  "installMethod": "$method"
}
EOF
    chmod 0640 "$temporary"
    mv -f "$temporary" "$state"
    trap - EXIT HUP INT TERM
}


validate_absolute_directory()
{
    directory=$1
    description=$2
    case "$directory" in
        /*)
            ;;
        *)
            fail 2 "$description must be an absolute path: $directory"
            ;;
    esac
}

start_operation_log()
{
    operation=$1
    method=$2
    current_version=$3
    target_version=$4

    validate_absolute_directory "$DEFAULT_LOG_ROOT" "log directory"
    timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
    started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    mkdir -p "$DEFAULT_LOG_ROOT"
    OPERATION_LOG="$DEFAULT_LOG_ROOT/$timestamp-$operation-$$.log"
    umask 027
    cat >"$OPERATION_LOG" <<EOF
logFormat=1
product=MDVWB
operation=$operation
method=$method
currentVersion=$current_version
targetVersion=$target_version
startedAt=$started_at
root=$MDVWB_ROOT
status=running
EOF
    chmod 0640 "$OPERATION_LOG"
    printf 'log=%s\n' "$OPERATION_LOG"
}

append_operation_log()
{
    key=$1
    value=$2
    [ -n "${OPERATION_LOG:-}" ] || return 0
    printf '%s=%s\n' "$key" "$value" >>"$OPERATION_LOG"
}

finish_operation_log()
{
    status=$1
    finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    append_operation_log finishedAt "$finished_at"
    append_operation_log finalStatus "$status"
}


validate_relative_backup_path()
{
    relative=$1
    case "$relative" in
        ""|/*|..|../*|*/..|*/../*)
            fail 2 "unsafe backup path: $relative"
            ;;
    esac
}

backup_inventory_contains()
{
    inventory=$1
    relative=$2
    awk -F '\t' -v relative="$relative" '
        $2 == relative { found = 1 }
        END { exit found ? 0 : 1 }
    ' "$inventory"
}

backup_add_path()
{
    relative=$1
    validate_relative_backup_path "$relative"
    if backup_inventory_contains "$BACKUP_INVENTORY" "$relative"; then
        return 0
    fi

    source_path=$(root_path "/$relative")
    destination="$BACKUP_FILES/$relative"
    destination_parent=${destination%/*}

    if [ -e "$source_path" ] || [ -L "$source_path" ]; then
        mkdir -p "$destination_parent"
        cp -a "$source_path" "$destination"
        printf 'present\t%s\n' "$relative" >>"$BACKUP_INVENTORY"
    else
        printf 'absent\t%s\n' "$relative" >>"$BACKUP_INVENTORY"
    fi
}

backup_record_service()
{
    service=$1
    if awk -F '\t' -v service="$service" '
        $1 == service { found = 1 }
        END { exit found ? 0 : 1 }
    ' "$BACKUP_SERVICES"; then
        return 0
    fi

    active=0
    enabled=0
    if "$MDVWB_SYSTEMCTL" is-active --quiet "$service" >/dev/null 2>&1; then
        active=1
    fi
    if "$MDVWB_SYSTEMCTL" is-enabled --quiet "$service" >/dev/null 2>&1; then
        enabled=1
    fi
    printf '%s\t%s\t%s\n' "$service" "$active" "$enabled" \
        >>"$BACKUP_SERVICES"
}

backup_fixed_paths()
{
    cat <<'EOF'
usr/local/bin/MDVWB
usr/local/bin/mdvwb-offline
usr/local/bin/mdvwb-manager
usr/local/bin/mdvwb-scheduler
usr/local/bin/mdvwb-bus
usr/local/sbin/mdvwb-setup
usr/local/lib/mdvwb
etc/mdvwb
etc/default/mdvwb
etc/default/mdvwb-manager
etc/default/mdvwb-scheduler
etc/systemd/system/mdvwb@.service
etc/systemd/system/mdvwb-manager.service
etc/systemd/system/mdvwb-scheduler.service
etc/systemd/system/mdvwb.service
etc/systemd/system/mdvwb-2.service
etc/wb-rules/mdvwb-service-control.js
var/lib/mdvwb
var/www/mdvwb
var/www/fancoils
EOF
}

create_backup()
{
    backup_root=$1
    reason=$2
    manager=$3

    case "$backup_root" in
        /*)
            ;;
        *)
            fail 2 "backup directory must be an absolute path: $backup_root"
            ;;
    esac

    created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    directory_name=$(date -u '+%Y%m%dT%H%M%SZ')-$$
    backup="$backup_root/$directory_name"
    if [ -e "$backup" ]; then
        fail 2 "backup destination already exists: $backup"
    fi

    mkdir -p "$backup/files"
    BACKUP_PATH=$backup
    BACKUP_FILES=$backup/files
    BACKUP_INVENTORY=$backup/paths.tsv
    BACKUP_SERVICES=$backup/services.tsv
    : >"$BACKUP_INVENTORY"
    : >"$BACKUP_SERVICES"

    backup_version=none
    if [ -s "$DEFAULT_STATE_PATH" ]; then
        load_state "$DEFAULT_STATE_PATH"
        backup_version=$STATE_VERSION
    fi

    cat >"$backup/backup.conf" <<EOF
MDVWB_BACKUP_FORMAT=1
MDVWB_BACKUP_PRODUCT=MDVWB
MDVWB_BACKUP_CREATED_AT=$created_at
MDVWB_BACKUP_REASON=$reason
MDVWB_BACKUP_VERSION=$backup_version
MDVWB_BACKUP_ROOT=$MDVWB_ROOT
EOF

    while IFS= read -r relative; do
        [ -n "$relative" ] || continue
        backup_add_path "$relative"
    done <<EOF
$(backup_fixed_paths)
EOF

    default_dir=$(root_path /etc/default)
    if [ -d "$default_dir" ]; then
        for path in "$default_dir"/mdvwb-[0-9]*; do
            [ -e "$path" ] || [ -L "$path" ] || continue
            relative=${path#"$ROOT_PREFIX/"}
            backup_add_path "$relative"
        done
    fi

    rules_dir=$(root_path /etc/wb-rules)
    if [ -d "$rules_dir" ]; then
        for rule in "$rules_dir"/*.js; do
            [ -f "$rule" ] || continue
            if grep -Eq 'var[[:space:]]+ArrID[[:space:]]*=' "$rule" &&
               grep -q 'defineVirtualDevice("Fan-"' "$rule"; then
                relative=${rule#"$ROOT_PREFIX/"}
                backup_add_path "$relative"
                backup_add_path "$relative.disabled-mdvwb"
            fi
        done
        for disabled in "$rules_dir"/*.disabled-mdvwb; do
            [ -e "$disabled" ] || [ -L "$disabled" ] || continue
            relative=${disabled#"$ROOT_PREFIX/"}
            backup_add_path "$relative"
            original=${relative%.disabled-mdvwb}
            backup_add_path "$original"
        done
    fi

    backup_record_service mdvwb-manager.service
    backup_record_service mdvwb-scheduler.service
    backup_record_service mdvwb.service
    backup_record_service mdvwb-2.service

    config=$(root_path /etc/mdvwb/buses.json)
    if [ -x "$manager" ] && [ -s "$config" ]; then
        for bus in $(configured_bus_ids "$manager" "$config"); do
            backup_add_path "etc/default/mdvwb-$bus"
            backup_record_service "mdvwb@$bus.service"
        done
    fi

    if [ -d "$default_dir" ]; then
        for path in "$default_dir"/mdvwb-[0-9]*; do
            [ -e "$path" ] || [ -L "$path" ] || continue
            name=${path##*/}
            bus=${name#mdvwb-}
            case "$bus" in
                ""|*[!0-9]*)
                    ;;
                *)
                    backup_record_service "mdvwb@$bus.service"
                    ;;
            esac
        done
    fi

    : >"$backup/COMPLETE"
    printf '%s\n' "$backup"
}

backup_value()
{
    backup=$1
    key=$2
    values=$(sed -n "s/^$key=//p" "$backup/backup.conf")
    count=$(printf '%s\n' "$values" | awk 'NF { count++ } END { print count + 0 }')
    [ "$count" -eq 1 ] ||
        fail 2 "backup field '$key' must occur exactly once in $backup/backup.conf"
    printf '%s\n' "$values"
}

validate_backup()
{
    backup=$1
    [ -d "$backup" ] || fail 3 "backup directory does not exist: $backup"
    require_file "$backup/backup.conf"
    require_file "$backup/COMPLETE"
    require_file "$backup/paths.tsv"
    require_file "$backup/services.tsv"
    [ -d "$backup/files" ] || fail 2 "backup files directory is missing: $backup/files"

    format=$(backup_value "$backup" MDVWB_BACKUP_FORMAT)
    product=$(backup_value "$backup" MDVWB_BACKUP_PRODUCT)
    backup_root=$(backup_value "$backup" MDVWB_BACKUP_ROOT)

    [ "$format" = "1" ] || fail 2 "unsupported backup format: $format"
    [ "$product" = "MDVWB" ] || fail 2 "unexpected backup product: $product"
    [ "$backup_root" = "$MDVWB_ROOT" ] ||
        fail 2 "backup root $backup_root differs from current root $MDVWB_ROOT"

    tab=$(printf '\t')
    while IFS="$tab" read -r status relative extra; do
        [ -n "$status" ] || continue
        [ -z "${extra:-}" ] || fail 2 "malformed backup inventory entry"
        case "$status" in
            present|absent)
                ;;
            *)
                fail 2 "unknown backup inventory state: $status"
                ;;
        esac
        validate_relative_backup_path "$relative"
        if [ "$status" = "present" ]; then
            source_path="$backup/files/$relative"
            [ -e "$source_path" ] || [ -L "$source_path" ] ||
                fail 2 "backup content is missing: $relative"
        fi
    done <"$backup/paths.tsv"
}

stop_services_for_restore()
{
    backup=$1
    current_manager=$(root_path /usr/local/bin/mdvwb-manager)
    current_config=$(root_path /etc/mdvwb/buses.json)

    "$MDVWB_SYSTEMCTL" stop mdvwb-scheduler.service 2>/dev/null || true
    "$MDVWB_SYSTEMCTL" stop mdvwb-manager.service 2>/dev/null || true
    if [ -x "$current_manager" ] && [ -s "$current_config" ]; then
        for bus in $(configured_bus_ids "$current_manager" "$current_config"); do
            "$MDVWB_SYSTEMCTL" stop "mdvwb@$bus.service" 2>/dev/null || true
        done
    fi

    tab=$(printf '\t')
    while IFS="$tab" read -r service active enabled extra; do
        [ -n "$service" ] || continue
        [ -z "${extra:-}" ] || fail 2 "malformed backup service entry"
        "$MDVWB_SYSTEMCTL" stop "$service" 2>/dev/null || true
    done <"$backup/services.tsv"
}

restore_backup_files()
{
    backup=$1
    tab=$(printf '\t')

    while IFS="$tab" read -r status relative extra; do
        [ -n "$status" ] || continue
        target=$(root_path "/$relative")
        rm -rf "$target"
    done <"$backup/paths.tsv"

    while IFS="$tab" read -r status relative extra; do
        [ -n "$status" ] || continue
        if [ "$status" = "present" ]; then
            source_path="$backup/files/$relative"
            target=$(root_path "/$relative")
            target_parent=${target%/*}
            mkdir -p "$target_parent"
            cp -a "$source_path" "$target"
        fi
    done <"$backup/paths.tsv"
}

restore_service_states()
{
    backup=$1
    restored_manager=$(root_path /usr/local/bin/mdvwb-manager)
    restored_config=$(root_path /etc/mdvwb/buses.json)

    "$MDVWB_SYSTEMCTL" daemon-reload

    if [ -x "$restored_manager" ] && [ -s "$restored_config" ]; then
        "$restored_manager" validate "$restored_config"
        "$restored_manager" apply "$restored_config"
    fi

    tab=$(printf '\t')
    while IFS="$tab" read -r service active enabled extra; do
        [ -n "$service" ] || continue
        case "$enabled" in
            1)
                "$MDVWB_SYSTEMCTL" enable "$service"
                ;;
            0)
                "$MDVWB_SYSTEMCTL" disable "$service" 2>/dev/null || true
                ;;
            *)
                fail 2 "invalid enabled state for $service: $enabled"
                ;;
        esac
    done <"$backup/services.tsv"

    while IFS="$tab" read -r service active enabled extra; do
        [ -n "$service" ] || continue
        case "$active" in
            1)
                "$MDVWB_SYSTEMCTL" start "$service"
                ;;
            0)
                "$MDVWB_SYSTEMCTL" stop "$service" 2>/dev/null || true
                ;;
            *)
                fail 2 "invalid active state for $service: $active"
                ;;
        esac
    done <"$backup/services.tsv"
}

restore_backup()
{
    backup=$1
    require_root
    validate_backup "$backup"

    printf '[rollback 1/4] Stop current MDVWB services\n'
    stop_services_for_restore "$backup"

    printf '[rollback 2/4] Restore files and configuration\n'
    restore_backup_files "$backup"

    printf '[rollback 3/4] Restore systemd service states\n'
    restore_service_states "$backup"

    printf '[rollback 4/4] Rollback complete\n'
    printf '%s\n' \
        "ROLLBACK_RESULT=success" \
        "backup=$backup"
}

latest_backup()
{
    backup_root=$1
    [ -d "$backup_root" ] || fail 3 "backup directory does not exist: $backup_root"

    latest=
    for candidate in $(ls -1dt "$backup_root"/* 2>/dev/null || true); do
        if [ -f "$candidate/backup.conf" ] &&
           [ -f "$candidate/COMPLETE" ]; then
            latest=$candidate
            break
        fi
    done
    [ -n "$latest" ] || fail 3 "no MDVWB backups were found in $backup_root"
    printf '%s\n' "$latest"
}


required_package_files()
{
    cat <<'EOF'
MDVWB
mdvwb-offline
mdvwb-manager
